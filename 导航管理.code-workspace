{
  "folders": [{"path": "."}],
  "settings": {"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"},
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "一键处理操作清单",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/一键处理.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}"
      },
      {
        "name": "高级：交互菜单",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/navigation.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}"
      }
    ]
  }
}
